# Local demo environment. Copy to .env (already gitignored).
API_PORT=8000
KAFKA_BROKER=localhost:9092
DB_URL=
REDIS_URL=redis://localhost:6379

# Generate a distinct random secret: openssl rand -hex 32
# Required for the driver-location /drivers* and /count API routes.
# Without a key these routes fail closed (503).
DRIVER_LOCATION_API_KEY=

# Default: publish NGINX only on local loopback. External bindings need
# TLS, a firewall, and an authenticated gateway.
DRIVER_API_BIND_ADDRESS=127.0.0.1
